SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
OFFICIAL_EMAIL=official@civiclens.app
OFFICIAL_PASSWORD=CivicLens@2026
OFFICIAL_NAME=City Operations Officer
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Claude vision (optional). With a key, Claude Sonnet 5.5 judges photos and writes
# a one-line description; CLIP still makes the duplicate fingerprints and takes over
# if Claude is unreachable or out of credit. Leave empty to use CLIP only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# auto = Claude when a key is set, clip = CLIP only (use this for test_e2e.py)
VISION_ENGINE=auto
CLAUDE_DAILY_LIMIT=150

# Vercel only: Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/recompute
CRON_SECRET=
